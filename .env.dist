# Copy to .env and fill in. Values starting with $ in app.config.yaml are read from here at deploy time.

# Order sync (main). Base URL of the ERP API; /orders is appended.
ERP_API_URL=
ERP_API_KEY=

# Ep 3: stuck-orders. Store base URL, e.g. https://shop.example.com (with or without a trailing slash).
# The token needs Sales > Operations > Orders (read); on PaaS also enable
# Stores > Configuration > Services > OAuth > Consumer Settings > "Allow OAuth Access Tokens to be used as standalone Bearer tokens".
COMMERCE_BASE_URL=
COMMERCE_TOKEN=
# Incoming-webhook URL (Slack/Teams style: a JSON body with a "text" field).
ALERT_WEBHOOK_URL=

# Ep 4: post-deploy hook (scripts/post-deploy-db-setup.js) creates the database indexes with the workspace's
# OAuth server-to-server credential (Developer Console > your workspace > OAuth Server-to-Server).
# The workspace needs the App Builder Data Services API, and the token is generated after adding it.
# Scopes: comma-separated, as shown on the credential. AIO_RUNTIME_NAMESPACE: the workspace's Runtime namespace
# (`aio where`; aio-lib-db needs it and aio does not set __OW_NAMESPACE for hooks; `aio app use` normally writes it into .env). The database region comes from app.config.yaml.
IMS_OAUTH_S2S_CLIENT_ID=
IMS_OAUTH_S2S_CLIENT_SECRET=
IMS_OAUTH_S2S_ORG_ID=
IMS_OAUTH_S2S_SCOPES=
AIO_RUNTIME_NAMESPACE=

# Ep 7: cart-check webhook. In Commerce, Stores > Settings > Configuration > Adobe Services > Webhooks: enable digital
# signatures, click "Regenerate key pair" and paste the public key here on ONE line, with \n for each line break
# (the action turns the \n back into newlines). Regenerating invalidates the old key: update this and redeploy together,
# or every genuine call fails the signature check and add-to-cart is blocked. If this is empty or not a valid key the
# action answers 500, and with required="false" in webhooks.xml Commerce fails open.
PUBLIC_KEY=
# Comma-separated SKUs the cart must refuse, e.g. RESTRICTED-1,RESTRICTED-2 (trimmed, case-sensitive).
RESTRICTED_SKUS=
