<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Own log file: var/log/mageminion_order_export.log -->
    <virtualType name="MageMinion\OrderExport\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/mageminion_order_export.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="MageMinion\OrderExport\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">mageminion_order_export</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">MageMinion\OrderExport\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="MageMinion\OrderExport\Observer\ExportOrder">
        <arguments>
            <argument name="sender" xsi:type="object">MageMinion\OrderExport\Model\Sender\Proxy</argument>
            <argument name="retry" xsi:type="object">MageMinion\OrderExport\Model\Retry\Proxy</argument>
            <argument name="logger" xsi:type="object">MageMinion\OrderExport\Logger</argument>
        </arguments>
    </type>
    <type name="MageMinion\OrderExport\Model\Sender">
        <arguments><argument name="logger" xsi:type="object">MageMinion\OrderExport\Logger</argument></arguments>
    </type>
    <type name="MageMinion\OrderExport\Cron\Retry">
        <arguments><argument name="logger" xsi:type="object">MageMinion\OrderExport\Logger</argument></arguments>
    </type>
</config>
