{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "array",
    "items": {
      "title": "Review",
      "type": "object",
      "properties": {
        "sku": { "type": "string" },
        "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "author": { "type": "string" }
      },
      "required": ["sku", "rating"]
    }
  }
}
