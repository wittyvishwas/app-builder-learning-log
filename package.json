{
  "name": "app-builder-learning-log",
  "version": "0.1.0",
  "private": true,
  "description": "Code for the MageMinion 'Learn App Builder with me' series: a Magento developer learning Adobe App Builder in public.",
  "license": "Apache-2.0",
  "scripts": {
    "test": "jest",
    "check:handoffs": "node scripts/check-handoffs.js",
    "postinstall": "npx aio-commerce-lib-app hooks postinstall",
    "typecheck:web-src": "tsc --noEmit -p src/commerce-backend-ui-2/web-src/tsconfig.json",
    "typecheck:actions": "tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:web-src && npm run typecheck:actions"
  },
  "dependencies": {
    "@adobe/aio-commerce-lib-admin-ui": "^1.1.0",
    "@adobe/aio-commerce-lib-app": "^2.0.0",
    "@adobe/aio-commerce-sdk": "^2.0.0",
    "@adobe/aio-lib-db": "^1.1.0",
    "@adobe/aio-lib-files": "^4.1.4",
    "@adobe/aio-lib-state": "^5.4.0",
    "@adobe/aio-sdk": "^6.0.0",
    "@react-spectrum/s2": "^1.5.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tsconfig/bases": "^1.0.28",
    "@types/node": "^24.13.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#app.commerce.config": "./src/commerce-extensibility-1/.generated/app.commerce.config.js",
    "#web/*": "./src/commerce-backend-ui-2/web-src/src/*"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "@parcel/bundler-default": {
    "manualSharedBundles": [
      {
        "assets": [
          "**/@react-spectrum/s2/**",
          "src/commerce-backend-ui-2/web-src/*.{js,jsx,ts,tsx}"
        ],
        "name": "s2-styles",
        "types": [
          "css"
        ]
      }
    ]
  }
}
